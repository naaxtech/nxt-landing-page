# Gmail credentials
# Use an App Password, NOT your main Gmail password.
# Enable 2FA on the account first, then:
# Google Account → Security → 2-Step Verification → App passwords → create one for "Mail"
GMAIL_USER=naaxtech.official@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Where to send form submissions
GMAIL_TO=naaxtech.official@gmail.com
GMAIL_CC=naaxtech.marketing@gmail.com

# Comma-separated list of allowed origins (your GitHub Pages URL)
ALLOWED_ORIGINS=https://naaxtech.github.io

# Port (Coolify will map this automatically)
PORT=3001
